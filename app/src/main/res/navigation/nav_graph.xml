<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.metask.view.onboarding.RegisterFragment"
        android:label="RegisterFragment" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.metask.view.onboarding.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_pendingTaskFragment"
            app:destination="@id/pendingTaskFragment" />
    </fragment>
    <fragment
        android:id="@+id/pendingTaskFragment"
        android:name="com.example.metask.view.home.PendingTaskFragment"
        android:label="fragment_pending_task"
        tools:layout="@layout/fragment_pending_task" >
        <action
            android:id="@+id/action_pendingTaskFragment_to_newTaskFragment"
            app:destination="@id/newTaskFragment" />
    </fragment>
    <fragment
        android:id="@+id/newTaskFragment"
        android:name="com.example.metask.view.home.NewTaskFragment"
        android:label="fragment_new_task"
        tools:layout="@layout/fragment_new_task" >
        <action
            android:id="@+id/action_newTaskFragment_to_pendingTaskFragment"
            app:destination="@id/pendingTaskFragment" />
        <action
            android:id="@+id/action_newTaskFragment_to_fragmentDetailTask2"
            app:destination="@id/fragmentDetailTask2" />
    </fragment>
    <fragment
        android:id="@+id/fragmentDetailTask2"
        android:name="com.example.metask.view.home.FragmentDetailTask"
        android:label="fragment_detail_task"
        tools:layout="@layout/fragment_detail_task" >
        <action
            android:id="@+id/action_fragmentDetailTask2_to_itemTaskFragment"
            app:destination="@id/itemTaskFragment" />
    </fragment>
    <fragment
        android:id="@+id/itemTaskFragment"
        android:name="com.example.metask.view.home.ItemTaskFragment"
        android:label="fragment_item_task"
        tools:layout="@layout/fragment_item_task" />
</navigation>